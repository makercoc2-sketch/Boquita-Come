# ─── Base de Datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/boquita_come

# ─── Servidor ─────────────────────────────────────────────────────────────────
# IP de la PC principal en la LAN
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ─── CORS (subredes LAN donde están las tablets) ──────────────────────────────
# Lista separada por comas. Ejemplo: http://192.168.1.0/24
CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:5173

# ─── Impresora Térmica USB ────────────────────────────────────────────────────
# Obtener con: python -c "import usb.core; print(list(usb.core.find(find_all=True)))"
PRINTER_VENDOR_ID=0x04b8    # Ejemplo: Epson
PRINTER_PRODUCT_ID=0x0202   # Ejemplo: TM-T20II

# ─── Negocio ──────────────────────────────────────────────────────────────────
BUSINESS_NAME=Boquita Come
BUSINESS_RUC=20123456789
BUSINESS_ADDRESS=Av. Principal 123, Lima, Perú
IGV_PERCENTAGE=10.5

# ─── Seguridad (futuro) ───────────────────────────────────────────────────────
SECRET_KEY=changeme_super_secret_key
